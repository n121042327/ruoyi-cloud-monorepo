{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruoyi-cloud-monorepo.local/schemas/baseline-manifest.schema.json",
  "title": "阶段基线冻结清单",
  "description": "阶段门禁通过时生成的产物清单，用于记录哪些文件在哪个提交被冻结。",
  "type": "object",
  "required": ["schemaVersion", "stage", "frozenAt", "commit", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "stage": {
      "type": "string",
      "enum": [
        "stage0-governance",
        "stage1-prd",
        "stage2-prototype-functional",
        "stage3-prototype-high-fidelity",
        "stage4-architecture",
        "stage5-detailed-design",
        "stage6-frontend",
        "stage7-backend",
        "stage8-acceptance"
      ]
    },
    "frozenAt": {
      "type": "string",
      "format": "date-time",
      "description": "冻结时间，ISO 8601"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "冻结时所在提交"
    },
    "approvedBy": {
      "type": "string",
      "description": "验收人"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "status"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "相对仓库根的路径，文件或目录"
          },
          "kind": {
            "type": "string",
            "enum": ["constraint", "spec", "design", "artifact", "evidence", "record"]
          },
          "status": {
            "type": "string",
            "enum": ["planned", "draft", "review", "frozen", "superseded"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "文件内容摘要；目录类型可省略"
          },
          "supersedes": {
            "type": "string",
            "description": "被本产物取代的旧版本路径"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^GAP-[0-9]{3}$" },
          "status": { "type": "string", "enum": ["open", "answered", "closed", "waived"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
